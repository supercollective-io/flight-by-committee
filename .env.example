# Simulator computer: copy to .env and chmod 600 .env.
# Use the existing deployed bridge key, not the participant invitation key.
FLIGHT_RELAY_URL=https://fly.supercollective.io
FLIGHT_BRIDGE_KEY=

# Hosted relay: configure these in Coolify, not on the simulator computer.
# Generate independent keys with secrets.token_urlsafe(32) for a new deployment.
# FLIGHT_PUBLIC_ORIGIN=https://fly.supercollective.io
# FLIGHT_PARTICIPANT_KEY=
# FLIGHT_BRIDGE_KEY=
# PORT=8080

# Optional shared operator API; distinct from participant and bridge keys.
# Configure the same value as HUB_FLIGHT_TOKEN in Hub.
# FLIGHT_OPERATOR_TOKEN=<independent URL-safe secret of 32–128 characters>
