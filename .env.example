# Runtime-only values in Coolify. Generate independent keys with secrets.token_urlsafe(32).
FLIGHT_PUBLIC_ORIGIN=https://flight.supercollective.io
FLIGHT_PARTICIPANT_KEY=
FLIGHT_BRIDGE_KEY=
PORT=8080
# Local simulator computer only; leave unset for the tested LAN route.
# FLIGHT_RELAY_URL=https://flight.supercollective.io

# Optional shared operator API; distinct from participant and bridge keys.
# Configure the same value as HUB_FLIGHT_TOKEN in Hub.
# FLIGHT_OPERATOR_TOKEN=<independent URL-safe secret of 32–128 characters>
